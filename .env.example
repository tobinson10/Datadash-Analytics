# Public browser configuration — add these in Vercel, never commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets — set only in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Paystack plan codes — set after creating the matching plans in Test Mode.
PAYSTACK_PLAN_STARTER_MONTHLY_USD=
PAYSTACK_PLAN_STARTER_ANNUAL_USD=
PAYSTACK_PLAN_PRO_MONTHLY_USD=
PAYSTACK_PLAN_PRO_ANNUAL_USD=
PAYSTACK_PLAN_STARTER_MONTHLY_NGN=
PAYSTACK_PLAN_STARTER_ANNUAL_NGN=
PAYSTACK_PLAN_PRO_MONTHLY_NGN=
PAYSTACK_PLAN_PRO_ANNUAL_NGN=

# Public production URL used for secure payment returns.
APP_URL=https://datadash-analytics.vercel.app
